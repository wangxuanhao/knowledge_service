# Configuration reference only: copy to .env and fill in real values.
# Never commit real secrets. Set environment variables in your terminal to override.

# ── PostgreSQL（Docker Compose）────────────────────────────────────────
# Docker Compose 会自动读取同目录的 .env；生产环境请设置高强度密码
POSTGRES_DB=knowledge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bestpay_knowledge_service
POSTGRES_APP_USER=knowledge_app
POSTGRES_APP_PASSWORD=bestpay_knowledge_service
POSTGRES_INITDB_ARGS=--data-checksums --encoding=UTF8 --locale=C
TZ=Asia/Shanghai

# ── 应用连库（T02 起 PostgreSQL 为唯一后端，SQLite 已弃用）─────────────────
# KG_DATABASE_URL：应用进程读取的连接串。留空则用
#   POSTGRES_DB / POSTGRES_APP_USER / POSTGRES_APP_PASSWORD 组装。
# 应用进程**不会**读取 POSTGRES_PASSWORD —— 超级用户口令不进应用，最小权限。
KG_DATABASE_URL=
KG_DATABASE_HOST=127.0.0.1
KG_DATABASE_PORT=5432

# KG_MIGRATION_DATABASE_URL：只给
#   python -m knowledge_service.repository.migrate
# 使用（建表/建索引需要 owner 权限）。留空则回退 POSTGRES_USER/POSTGRES_PASSWORD。
KG_MIGRATION_DATABASE_URL=

# ── 测试专用：不设则自动跳过需要真实数据库的用例 ─────────────────────────
# KG_TEST_POSTGRES_DSN=postgresql://postgres:<pw>@127.0.0.1:5432/knowledge
# KG_TEST_POSTGRES_APP_DSN=postgresql://knowledge_app:<pw>@127.0.0.1:5432/knowledge
#
# KG_SKIP_DOTENV=1 会让 .env **整体不加载**（只给测试套件用，见 tests/conftest.py）。
# 平时不要设：应用靠它把 .env 载入进程。测试里由 conftest 自动设成 1，
# 以保证单元测试密闭、不随开发者本机 .env 内容改变行为。

# ── 存储 ────────────────────────────────────────────────────────────────
# PostgreSQL 是唯一业务真值库，**没有** SQLite 回退。
# 应用进程只读 KG_DATABASE_URL 或 POSTGRES_APP_* / POSTGRES_DB 组装 DSN
# （见 knowledge_service/repository/connection.py 的 resolve_dsn）。
# 遗留的 KG_DATABASE（SQLite 路径）已被**明确拒绝**：配置了它会让服务拒绝启动并
# 点名该键，避免「以为写进了 PG、其实写到了本地文件」。

# ── 向量编码 ────────────────────────────────────────────────────────────
# local = 本地 bge-m3（默认）；openai = OpenAI 兼容远程；demo = 非语义哈希（仅流程验证）
KG_EMBEDDING_BACKEND=local
# 本地模型目录（仅 backend=local 时使用）
KG_EMBEDDING_PATH=data/model
# 编码批大小（1..64，仅 backend=local 时使用）
KG_EMBEDDING_BATCH_SIZE=4
# 可选 OpenAI 兼容 embedding 提供商（仅 backend=openai 时使用）
KG_EMBEDDING_BASE_URL=
KG_EMBEDDING_MODEL=
KG_EMBEDDING_API_KEY=

# ── LLM 抽取与问答 ──────────────────────────────────────────────────────
# 用于 Semantica 抽取和生成式证据问答（本地检索不依赖这些）
KG_LLM_BASE_URL=
KG_LLM_MODEL=
KG_LLM_API_KEY=
# 出口代理：留空 = 直连（推荐）。
# httpx 默认会去读 Windows 注册表里的系统代理，本机实测该系统代理对 LLM 端点
# 不稳定（3 次里 2 次 TLS 握手超时，直连 3/3 稳定在 0.2s），因此应用**显式不继承**
# 系统代理（见 knowledge_service/core/net.py）。确需走代理时填 http://127.0.0.1:7890。
KG_LLM_PROXY=

# ── 认证与权限 ──────────────────────────────────────────────────────────
# 角色三档：superadmin（超级管理员，系统之根）/ admin（可写入、建模发布、管普通账号）
#           / viewer（只能检索、问答、查看脑图与台账）。
# KG_JWT_SECRET：登录令牌的签名密钥。**生产必填**：留空时每次启动随机生成，
#   服务一重启所有人都得重新登录。请用长随机串（如 openssl rand -base64 48）。
KG_JWT_SECRET=
# 访问令牌有效期（秒），默认 43200 = 12 小时
KG_JWT_TTL_SECONDS=43200
# 首次启动（库里还没有任何用户）时播种的超级管理员账号/口令；老库无超级管理员时
#   会把该账号（不存在则取最早的管理员）提升为超级管理员。
# 仅为本地零配置可用，生产请通过这两个变量提供强值，登录后尽快改口令。
KG_SEED_ADMIN_USERNAME=admin
KG_SEED_ADMIN_PASSWORD=
# KG_AUTH_DISABLED：关闭鉴权的开关，**只给测试套件用（conftest 自动设置）**。
# 生产/容器绝不设置，否则 /api/* 将完全不做认证。
# KG_AUTH_DISABLED=1

# ── 文档解析（Semantica + Docling）──────────────────────────────────────
# auto = PDF 需要时启用 Docling OCR（默认）；disabled = 禁用 OCR
# 模型权重由本机运维安装/缓存，服务不会把模型文件写入项目数据库
KG_DOCUMENT_OCR_MODE=auto

# ── 向量检索（Milvus，可选）─────────────────────────────────────────────
# 显式设为 milvus 才开启；连接失败自动降级本地，不拖垮主流程
KG_VECTOR_BACKEND=milvus
# 本地 Milvus 地址（milvus-standalone 默认端口 19530）
KG_MILVUS_HOST=localhost
KG_MILVUS_PORT=19530
# 向量维度（bge-m3 为 1024）
KG_MILVUS_DIM=1024

# ── 日志 ────────────────────────────────────────────────────────────────
# 终端日志级别（DEBUG/INFO/WARNING/ERROR）；文件落盘恒为 DEBUG
KG_LOG_LEVEL=INFO
# 只打印慢于该毫秒数的读路径阶段（如 200）
KG_SLOW_MS=0

# ── Neo4j 图谱投影（可选）───────────────────────────────────────────────
# PostgreSQL 是唯一业务真值库；按项目手动同步图谱副本
KG_NEO4J_URI=neo4j://127.0.0.1:7687
KG_NEO4J_USERNAME=neo4j
KG_NEO4J_DATABASE=neo4j
KG_NEO4J_PASSWORD=

# ── Milvus（Docker Compose：etcd + minio + standalone）──────────────────
# 容器数据目录根路径；相对 compose 文件所在目录，也可写绝对路径（如 D:/workspace/milvus）
DOCKER_VOLUME_DIRECTORY=./volumes
# Milvus 对象存储凭证；同时注入 minio 与 milvus 两个容器，两处必须一致，
# 且初始化后不可随意更换（换了读不到已有 bucket）。生产环境务必改成强随机值。
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
