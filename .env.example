# Configuration reference only: set environment variables in your terminal.
# Neo4j keys are loaded as a compatibility fallback; prefer .env. Never commit real secrets.
KG_DATABASE=data/service/knowledge.sqlite
KG_EMBEDDING_BACKEND=local
KG_EMBEDDING_PATH=data/model
# Optional OpenAI-compatible embedding provider:
KG_EMBEDDING_BASE_URL=
KG_EMBEDDING_MODEL=
KG_EMBEDDING_API_KEY=
# Needed for Semantica extraction and generated answers, not local retrieval:
KG_LLM_BASE_URL=
KG_LLM_MODEL=
KG_LLM_API_KEY=
# Optional graph projection. SQLite remains primary; explicit per-project sync.
KG_NEO4J_URI=neo4j://127.0.0.1:7687
KG_NEO4J_USERNAME=neo4j
KG_NEO4J_DATABASE=samr
KG_NEO4J_PASSWORD=
