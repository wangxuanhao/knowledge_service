  "findings": [
    {
      "priority": 0,
      "finding": "Repository uses one SqliteishConnection/raw psycopg connection and process-wide RLock. Readonly pagination calls get_project under the same lock. Async auth middleware synchronously calls UserStore.get_by_id on the same connection.",
      "sources": [
        "knowledge_service/repository/core.py:188",
        "knowledge_service/repository/core.py:679",
        "knowledge_service/repository/pg_engine.py:157",
        "knowledge_service/api/security_middleware.py:171",
        "knowledge_service/repository/users_store.py:79"
      ],
      "action": "Use a dedicated read connection/unit-of-work for each request and explicit consistent snapshots; preserve transaction and writer serialization rules. Move blocking auth database work off the event loop and isolate it from long scans."
    },
    {
      "priority": 0,
      "finding": "Unauthenticated app shell is visible while auth awaits DOMContentLoaded, health policy and session check; heavy vendor scripts precede auth.",
      "sources": [
        "knowledge_service/web/index.html:3",
        "knowledge_service/web/index.html:92",
        "knowledge_service/web/auth.js:238",
        "knowledge_service/web/auth.js:276"
      ],
      "action": "Hide/protect shell before first paint, run a small auth bootstrap first, initialize business modules after session validation; lazily load page/vendor code."
    },
    {
      "priority": 1,
      "finding": "Project switch/startup requests reclassification while ontology page is hidden; it scans all knowledge records and blocks unrelated requests.",
      "sources": [
        "knowledge_service/web/ontology-model-reclassify.js:101",
        "knowledge_service/web/ontology-model-reclassify.js:461",
        "knowledge_service/web/ontology-model-reclassify.js:473",
        "knowledge_service/services/reclassify.py:138"
      ],
      "action": "Load only when the relevant panel is visible; deduplicate in-flight loads and cancel irrelevant browser work; use bounded aggregate/read model for summary."
    },
    {
      "priority": 1,
      "finding": "Compact ontology discovery still reads all current_records. Publish readiness recomputes validation on page entry. Sources scans the whole project and returns document bodies.",
      "sources": [
        "knowledge_service/services/ontology_discovery_workflow.py:684",
        "knowledge_service/services/ontology_drafts_review.py:582",
        "knowledge_service/services/explorer.py:291"
      ],
      "action": "Use indexed scope-aware summaries/aggregates and document directory pagination; load source body on selection. Version readiness by authoritative project/draft revisions and perform mandatory validation at explicit validation/publish boundaries."
    },
    {
      "priority": 1,
      "finding": "A 50-row ledger view issued 56 requests: 50 separate assertion reads plus pagination/counts/ontologies/reviews.",
      "sources": [
        "knowledge_service/web/records-view.js:512",
        "knowledge_service/web/records-view.js:543",
        "knowledge_service/web/records-view.js:552"
      ],
      "action": "Batch visible-row lineage and endpoint summaries; obtain detailed evidence on demand; combine counts into one bounded query."
    },
    {
      "priority": 2,
      "finding": "Ontology render rebuilds hidden cards and per-card indexes; new canvas node placement repeatedly scans existing nodes. Larger ontology rendering risk is separate from observed small ontology network waits.",
      "sources": [
        "knowledge_service/web/ontology-model.js:392",
        "knowledge_service/web/ontology-model-catalog.js:12",
        "knowledge_service/web/ontology-model-catalog.js:60",
        "knowledge_service/web/ontology-model-canvas.js:229"
      ],
      "action": "Cache class/property indexes by ontology revision; skip hidden views; update selection state without rebuilding cards and graph; paginate/virtualize large lists."
    }
