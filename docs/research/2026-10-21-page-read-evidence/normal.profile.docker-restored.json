        {
          "sql": "WITH qualified AS (\n            SELECT r.id,r.version,r.version_id,r.read_kind AS kind,\n                    r.read_type AS type,NULLIF(r.read_type,'') AS group_type,\n                    NULLIF(r.payload::jsonb->>'ontology_id','') AS ontology_id\n                FROM record_versions r WHERE r.project_id=? AND r.superseded_at IS NULL AND r.read_visible AND TRUE AND r.read_kind = ? UNION ALL SELECT r.id,r.version,r.version_id,r.read_kind AS kind,\n                    r.read_type AS type,NULLIF(r.read_type,'') AS group_type,\n                    NULLIF(r.payload::jsonb->>'ontology_id','') AS ontology_id\n                FROM record_versions r WHERE r.project_id=? AND r.superseded_at IS NULL AND r.read_visible AND TRUE AND r.read_kind = ? AND EXISTS (SELECT 1 FROM record_versions s WHERE s.id=r.read_subject_id AND s.read_kind='entity' AND s.project_id=? AND s.superseded_at IS NULL AND s.read_visible AND TRUE) AND EXISTS (SELECT 1 FROM record_versions t WHERE t.id=r.read_object_id AND t.read_kind='entity' AND t.project_id=? AND t.superseded_at IS NULL AND t.read_visible AND TRUE) UNION ALL SELECT r.id,r.version,r.version_id,r.read_kind AS kind,\n                    r.read_type AS type,NULLIF(r.read_type,'') AS group_type,\n                    NULLIF(r.payload::jsonb->>'ontology_id','') AS ontology_id\n                FROM record_versions r WHERE r.project_id=? AND r.superseded_at IS NULL AND r.read_visible AND TRUE AND r.read_kind = ? AND EXISTS (SELECT 1 FROM record_versions s WHERE s.id=r.read_subject_id AND s.read_kind='entity' AND s.project_id=? AND s.superseded_at IS NULL AND s.read_visible AND TRUE)\n        ), ranked AS (\n            SELECT q.*,row_number() OVER (\n                PARTITION BY ontology_id,kind,group_type ORDER BY id,version) AS position\n            FROM qualified q\n        ) SELECT ontology_id,kind,\n            max(type) FILTER (WHERE position=1) AS type,count(*) AS record_count,\n            array_agg(version_id ORDER BY id,version) FILTER (\n                WHERE ontology_id IS DISTINCT FROM ? AND position<=?) AS sample_version_ids\n          FROM ranked GROUP BY ontology_id,kind,group_type\n          ORDER BY ontology_id NULLS FIRST,kind,group_type NULLS FIRST",
          "ms": 15.2,
          "parameter_count": 11
        }
      ],
