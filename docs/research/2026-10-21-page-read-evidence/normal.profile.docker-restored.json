          "sql": "SELECT count(*) FROM record_versions r WHERE r.project_id=? AND r.superseded_at IS NULL AND r.read_visible AND TRUE AND r.read_kind = ?",
          "ms": 3.41,
          "parameter_count": 2
        },
        {
          "sql": "SELECT r.id,r.version,r.version_id,r.read_kind AS kind,r.read_type AS type,r.read_text AS text,r.read_subject_id AS subject_id,r.read_object_id AS object_id FROM record_versions r WHERE r.project_id=? AND r.superseded_at IS NULL AND r.read_visible AND TRUE AND r.read_kind = ? ORDER BY r.id,r.version LIMIT ?",
          "ms": 5.72,
          "parameter_count": 3
        },
        {
          "sql": "SELECT r.project_id,r.id,r.version,r.version_id,\n            r.recorded_at,r.superseded_at,jsonb_build_object('id',r.id,'kind','document',\n                'valid_from',r.payload::jsonb->'valid_from','valid_until',r.payload::jsonb->'valid_until',\n                'metadata',jsonb_strip_nulls(jsonb_build_object('title',r.payload::jsonb#>'{metadata,title}','source_file',r.payload::jsonb#>'{metadata,source_file}','source_format',r.payload::jsonb#>'{metadata,source_format}','source_size_bytes',r.payload::jsonb#>'{metadata,source_size_bytes}','document_parser',r.payload::jsonb#>'{metadata,document_parser}','page_count',r.payload::jsonb#>'{metadata,page_count}','source_document_version_id',r.payload::jsonb#>'{metadata,source_document_version_id}','status',r.payload::jsonb#>'{metadata,status}')))::text AS payload\n            FROM record_versions r WHERE r.project_id=? AND r.version_id=ANY(?::text[])",
          "ms": 165.79,
          "parameter_count": 2
        },
        {
          "sql": "WITH associations AS (SELECT a.document_id,a.canonical_record_id FROM assertions a\n                WHERE a.project_id=? AND a.document_id=ANY(?::text[])\n                  AND a.status='accepted' AND a.canonical_record_id IS NOT NULL), linked AS MATERIALIZED (\n            SELECT a.document_id,r.id,r.version FROM associations a\n              JOIN record_versions r ON r.project_id=? AND r.id=a.canonical_record_id\n            UNION\n            SELECT payload::jsonb->>'source_id',id,version FROM record_versions\n            WHERE project_id=? AND payload::jsonb->>'source_id'=ANY(?::text[])\n        ), matches AS (\n            SELECT l.document_id,r.read_kind AS kind,r.id,r.read_type AS type,r.read_text AS text,\n                count(*) OVER (PARTITION BY l.document_id,r.read_kind) AS total,\n                row_number() OVER (PARTITION BY l.document_id,r.read_kind ORDER BY r.id,r.version) AS position\n            FROM linked l JOIN record_versions r ON r.id=l.id AND r.version=l.version\n            WHERE r.project_id=? AND r.superseded_at IS NULL AND r.read_visible AND TRUE AND r.read_kind = ANY(?::text[]) AND (r.read_kind NOT IN ('relation','attribute') OR (EXISTS (SELECT 1 FROM record_versions s WHERE s.id=r.read_subject_id AND s.read_kind='entity' AND s.project_id=? AND s.superseded_at IS NULL AND s.read_visible AND TRUE OFFSET 0) AND (r.read_kind='attribute' OR EXISTS (SELECT 1 FROM record_versions t WHERE t.id=r.read_object_id AND t.read_kind='entity' AND t.project_id=? AND t.superseded_at IS NULL AND t.read_visible AND TRUE OFFSET 0))))\n        ) SELECT document_id,kind,id,type,text,total FROM matches\n          WHERE position<=CASE kind WHEN 'chunk' THEN 10 WHEN 'attribute' THEN 1 ELSE 20 END\n          ORDER BY document_id,kind,position",
          "ms": 26.4,
          "parameter_count": 9
        }
