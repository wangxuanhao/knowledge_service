          "sql": "SELECT CASE r.payload::jsonb#>>'{metadata,status}'\n                WHEN 'failed' THEN 'failed' WHEN 'processing' THEN 'processing' ELSE 'ready' END AS state,\n                count(*) AS count FROM record_versions r WHERE r.project_id=? AND r.superseded_at IS NULL AND r.read_visible AND TRUE AND r.read_kind = ? GROUP BY 1",
