@prefix ex: <http://example.com/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:AIModel a owl:Class ;
    rdfs:label "AIModel" ;
    rdfs:subClassOf ex:Product .

ex:City a owl:Class ;
    rdfs:label "City" ;
    rdfs:subClassOf ex:Location .

ex:TechCompany a owl:Class ;
    rdfs:label "TechCompany" ;
    rdfs:subClassOf ex:Company .

ex:ceo_of a owl:ObjectProperty ;
    rdfs:comment "担任某公司CEO" ;
    rdfs:domain ex:Person ;
    rdfs:range ex:Company .

ex:competes_with a owl:ObjectProperty ;
    rdfs:comment "与...竞争" ;
    rdfs:domain ex:Company ;
    rdfs:range ex:Company .

ex:develops a owl:ObjectProperty ;
    rdfs:comment "开发某产品" ;
    rdfs:domain ex:Company ;
    rdfs:range ex:Product .

ex:founded_by a owl:ObjectProperty ;
    rdfs:comment "公司由某人创立" ;
    rdfs:domain ex:Company ;
    rdfs:range ex:Person .

ex:located_in a owl:ObjectProperty ;
    rdfs:comment "位于某地" ;
    rdfs:domain ex:Organization ;
    rdfs:range ex:Location .

ex:released_on a owl:ObjectProperty ;
    rdfs:comment "发布日期" ;
    rdfs:domain ex:Product ;
    rdfs:range ex:Date .

ex:Date a owl:Class ;
    rdfs:label "Date" .

ex:Location a owl:Class ;
    rdfs:label "Location" .

ex:Organization a owl:Class ;
    rdfs:label "Organization" .

ex:Person a owl:Class ;
    rdfs:label "Person" .

ex:Product a owl:Class ;
    rdfs:label "Product" .

ex:Company a owl:Class ;
    rdfs:label "Company" ;
    rdfs:subClassOf ex:Organization .

